# Copiez ce fichier en `.env` (ignoré par git) et adaptez les valeurs.
# Toutes les variables sont optionnelles.

# Port d'écoute du serveur (défaut : 3000). Cloud Run et la plupart des hébergeurs le définissent eux-mêmes.
# PORT=3000

# URL publique de l'application, par exemple https://echiquier.example.com
# Elle est toujours autorisée à appeler /api ; les requêtes de même origine n'ont besoin de rien.
# APP_URL=""

# Origines supplémentaires autorisées à appeler /api depuis un autre site (CORS), séparées par des virgules.
# ALLOWED_ORIGINS="https://mon-frontend.example.com"

# Nombre de reverse proxies devant le serveur, pour que les limites de débit utilisent la vraie IP du client
# (X-Forwarded-For). Réglé automatiquement à 1 sur Cloud Run (variable K_SERVICE) ; à laisser vide si le
# serveur est exposé directement.
# TRUST_PROXY="1"

# --- À la construction (bun run build / vite build) ---
# Adresse de l'API quand elle est sur un autre hôte que l'interface (par exemple interface sur GitHub Pages,
# API sur Cloud Run). Sans barre finale. Vide : l'interface appelle /api sur son propre hôte.
# VITE_API_URL="https://mon-service.europe-west2.run.app"

# Sous-dossier du site, avec barres de début et de fin (GitHub Pages : /nom-du-depot/). Défaut : /
# BASE_PATH="/echiquierIA/"

# Identifiant client OAuth du bouton « Synchroniser avec Google Drive » (type « Application Web » dans Google Cloud,
# avec l'origine de l'interface comme origine JavaScript autorisée). Il est public : il finit dans la page. Sans
# lui, le bouton n'est pas affiché. Sur GitHub Pages, le workflow le prend dans la variable GOOGLE_CLIENT_ID.
# VITE_GOOGLE_CLIENT_ID="123456789-abc.apps.googleusercontent.com"
